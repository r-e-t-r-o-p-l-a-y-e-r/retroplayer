    <string name="data_storage_intro">Retro Player configurationes applicationis in parva base datorum locali servat. Musica tua et series carminum ut documenta solita in thecis a te electis manent.</string>
    <string name="data_storage_app_data_title">Database applicationum</string>
    <string name="data_storage_app_data_body">Archivum: %1$s\nVias: %2$s\n\nBibliothecam, statum pervestigationis, resumptionem ludi, aequalizerum, thema, et praferentias linguae.</string>
    <string name="data_storage_library_title">Fasciculi musicae</string>
    <string name="data_storage_library_body">Fasciculi sonori numquam in basim datorum applicationis describuntur. Adde plicas bibliothecae et Retro Player fasciculos directe ex disco legit.</string>
    <string name="data_storage_playlists_title">Index canticorum</string>
