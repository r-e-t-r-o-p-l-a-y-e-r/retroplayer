    <string name="data_storage">Ìfipamọ́ dátà</string>
    <string name="data_storage_intro">Retro Player n tọju awọn eto app sinu ibi ipamọ data agbegbe kekere kan. Orin ati awọn akojọ orin rẹ wa bi awọn faili deede ninu awọn folda ti o yan.</string>
    <string name="data_storage_app_data_title">Ibi ipamọ data ohun elo</string>
    <string name="data_storage_app_data_body">Fáìlì: %1$s\nIpa ọ̀nà: %2$s\n\nṢípamọ́ àwọn ìpìlẹ̀ ìkàwé, ṣíṣàwárí ipò, ìtúnṣe ìgbàsókè, olùṣe àtúnṣe, àkòrí, àti àwọn ìfẹ́ èdè.</string>
    <string name="data_storage_library_title">Àwọn fáìlì orin</string>
    <string name="data_storage_library_body">A kò lè da àwọn fáìlì ohùn sínú ibi ìkópamọ́ ohun èlò náà rárá. Fi àwọn fáìlì ìkàwé kún un, Retro Player sì máa ń ka àwọn fáìlì tààrà láti inú fáìlì.</string>
    <string name="data_storage_playlists_title">Àwọn fáìlì àkójọ orin</string>
    <string name="data_storage_playlists_body">Àwọn àkójọ orin jẹ́ àwọn fáìlì .m3u lásán tí a tọ́jú sínú àwọn fáìlì ìkàwé rẹ. O lè ṣàtúnṣe wọn nínú àpù náà tàbí pẹ̀lú èyíkéyìí olóòtú ọ̀rọ̀.</string>
    <string name="data_storage_platform_title">Pẹpẹ: %1$s</string>
    <string name="data_storage_android_permissions_title">Awọn igbanilaaye ati ibi ipamọ Android</string>
    <string name="data_storage_android_native_body">Retro Player n tọju ibi ipamọ data rẹ ni agbegbe atilẹyin app-ikọkọ lori ibi ipamọ inu. Awọn faili orin rẹ wa ninu awọn folda ti o yan pẹlu oluyan folda eto naa.</string>
    <string name="data_storage_android_playback_title">Sisisẹsẹhin abẹlẹ Android</string>
    <string name="data_storage_android_playback_body">Nígbà tí ohùn bá ń ṣiṣẹ́, Retro Player ń ṣiṣẹ́ iṣẹ́ media iwájú, nítorí náà, ìṣíṣẹ́ náà ń tẹ̀síwájú tí o bá ti fóònù tàbí tí o bá yí àwọn app padà, pẹ̀lú àwọn ìṣàkóso ìrìnnà nínú ìfitónilétí ètò náà. Fífi àpù náà kúrò ní Recents máa ń dá ìṣíṣẹ́ náà dúró, ó sì máa ń yọ ìfitónilétí náà kúrò.</string>
    <string name="data_storage_platform_body_android">A fi data ohun elo pamọ sinu agbegbe atilẹyin ohun elo-ikọkọ lori ibi ipamọ inu.</string>
