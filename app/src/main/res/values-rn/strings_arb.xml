    <string name="data_storage">Ububiko bw\'amakuru</string>
    <string name="data_storage_intro">Retro Player igumya amategeko ya porogarama mu bubiko buto bw’amakuru bwo mu karere. Umuziki wawe n’urutonde rwawe biguma ari amadosiye asanzwe mu madosiye uhisemwo.</string>
    <string name="data_storage_app_data_title">Ububiko bw\'amakuru</string>
    <string name="data_storage_app_data_body">Dosiye: %1$s\nInzira: %2$s\n\nUbubiko bw\'imizi y\'ububiko bw\'ibitabo, uburyo bwo gushakisha, gusubiramwo, gukingira, insanganyamatsiko, n\'ururimi ukunda.</string>
    <string name="data_storage_library_title">Amadosiye y\'umuziki</string>
    <string name="data_storage_library_body">Amadosiye y’amajwi ntabwo yigera akopororwa mu rutonde rw’amakuru rwa porogarama. Yongerako amadosiye y\'ibitabo na Retro Player isoma amadosiye ataco akoresheje kuri disiki.</string>
    <string name="data_storage_playlists_title">Urutonde rw\'amadosiye</string>
    <string name="data_storage_playlists_body">Urutonde rw\'indirimbo ni amadosiye .m3u asanzwe abitswe mu madosiye yawe y\'ibitabo. Ushobora kubihindura muri app canke ukoresheje umuhinduzi w’ivyanditswe uwo ari we wese.</string>
    <string name="data_storage_platform_title">Urubuga: %1$s</string>
    <string name="data_storage_android_permissions_title">Uruhusha rwa Android n\'ububiko</string>
    <string name="data_storage_android_native_body">Retro Player ibika urutonde rwayo rw’amakuru mu karere k’ubufasha bw’ibanga kuri porogarama ku bubiko bw’imbere. Amadosiye yawe y\'umuziki aguma mu madosiye utoranya n\'igikoresho co gutoranya amadosiye ya sisitemu.</string>
    <string name="data_storage_android_playback_title">Gusubiramwo inyuma ya Android</string>
    <string name="data_storage_android_playback_body">Igihe amajwi ariko arakina, Retro Player ikoresha ubuhinga bwo gutangaza amakuru ku buryo gukina bibandanya iyo ufunze telefone canke uhinduye porogarama, n’ubugenzuzi bw’ugutwara mu itangazo rya sisitemu. Gukura kuri Recents birahagarika gusubiramwo maze bikakuraho itangazo.</string>
    <string name="data_storage_platform_body_android">Amakuru ya porogaramu abikwa mu karere k\'ubufasha bwa porogaramu ku bubiko bw\'imbere.</string>
