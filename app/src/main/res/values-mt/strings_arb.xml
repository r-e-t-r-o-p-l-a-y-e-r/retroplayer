    <string name="data_storage">Ħażna tad-dejta</string>
    <string name="data_storage_intro">Retro Player iżomm l-issettjar tal-app f\'bażi żgħira ta\' dejta lokali. Il-mużika tiegħek u l-playlists tiegħek jibqgħu bħala fajls normali f\'folderi li tagħżel.</string>
    <string name="data_storage_app_data_title">Database tal-app</string>
    <string name="data_storage_app_data_body">Fajl: %1$s\nTriq: %2$s\n\nJaħżen il-preferenzi tal-librerija, tal-istat tal-browsing, tar-riżum tal-plejbek, tal-eqwalizzatur, tat-tema, u tal-lingwa.</string>
    <string name="data_storage_library_title">Fajls tal-mużika</string>
    <string name="data_storage_library_body">Il-fajls tal-awdjo qatt ma jiġu kkopjati fid-database tal-app. Żid folders tal-librerija u Retro Player jaqra l-fajls direttament mid-diska.</string>
    <string name="data_storage_playlists_title">Fajls tal-playlist</string>
    <string name="data_storage_playlists_body">Il-playlists huma fajls .m3u sempliċi maħżuna ġewwa l-folderi tal-librerija tiegħek. Tista\' teditjahom fl-app jew b\'kull editur tat-test.</string>
    <string name="data_storage_platform_title">Pjattaforma: %1$s</string>
    <string name="data_storage_android_permissions_title">Permessi u ħażna ta\' Android</string>
    <string name="data_storage_android_native_body">Retro Player jaħżen il-bażi tad-dejta tiegħu fl-ispazju ta\' appoġġ privat tal-app fuq l-ħażna interna. Il-fajls tal-mużika tiegħek jibqgħu f\'folderi li tagħżel bl-għażla tal-folder tas-sistema.</string>
    <string name="data_storage_android_playback_title">Riproduzzjoni fil-isfond ta\' Android</string>
    <string name="data_storage_android_playback_body">Meta l-awdjo jkun qed jitħaddem, Retro Player jmexxi servizz medjatiku fil-quddiem sabiex il-plejbek ikompli jekk issakkar it-telefon jew tibdel l-apps, b\'kontrolli tat-trasport fin-notifika tas-sistema. Meta tneħħi l-app mill-aħħar użati, il-plejbek jieqaf u n-notifika titneħħa.</string>
    <string name="data_storage_platform_body_android">Id-dejta tal-app hija maħżuna fl-ispazju ta\' appoġġ privat tal-app fuq il-ħażna interna.</string>
