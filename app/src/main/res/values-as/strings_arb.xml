    <string name="data_storage">তথ্য সংৰক্ষণ</string>
    <string name="data_storage_intro">ৰেট্ৰ\' প্লেয়াৰে এপৰ ছেটিংসমূহ এটা সৰু স্থানীয় ডাটাবেছত ৰাখে। আপোনাৰ সংগীত আৰু প্লেলিষ্টসমূহ আপুনি বাছনি কৰা ফোল্ডাৰত সাধাৰণ ফাইল হিচাপে থাকে।</string>
    <string name="data_storage_app_data_title">এপৰ ডাটাবেছ</string>
    <string name="data_storage_app_data_body">ফাইল: %1$s\nপথ: %2$s\n\nষ্ট\'ৰ লাইব্ৰেৰী ৰুট, ব্ৰাউজ ষ্টেট, প্লেবেক ৰিজ্যুমে, ইকুৱেলাইজাৰ, থিম, আৰু ভাষাৰ পছন্দ।</string>
    <string name="data_storage_library_title">সংগীত ফাইলসমূহ</string>
    <string name="data_storage_library_body">অডিঅ\' ফাইলবোৰ এপৰ ডাটাবেছত কেতিয়াও কপি কৰা নহয়। লাইব্ৰেৰী ফোল্ডাৰ যোগ কৰক আৰু ৰেট্ৰ\' প্লেয়াৰে ডিস্কৰ পৰা পোনপটীয়াকৈ ফাইল পঢ়ে।</string>
    <string name="data_storage_playlists_title">প্লেলিষ্ট ফাইলসমূহ</string>
    <string name="data_storage_playlists_body">প্লেলিষ্টবোৰ হৈছে সাধাৰণ .m3u ফাইল, যিবোৰ আপোনাৰ লাইব্ৰেৰী ফোল্ডাৰৰ ভিতৰত সংৰক্ষিত থাকে। আপুনি সেইবোৰ এপটোত বা যিকোনো টেক্সট এডিটৰৰ সহায়ত সম্পাদনা কৰিব পাৰে।</string>
    <string name="data_storage_platform_title">প্লেটফৰ্ম: %1$s</string>
    <string name="data_storage_android_permissions_title">এণ্ড্ৰইড অনুমতি আৰু সংৰক্ষণ</string>
    <string name="data_storage_android_native_body">ৰেট্ৰ\' প্লেয়াৰে ইয়াৰ ডাটাবেছটো ইণ্টাৰনেল ষ্ট\'ৰেজৰ এপ-প্ৰাইভেট ছাপ\'ৰ্ট এলেকাত সংৰক্ষণ কৰে। আপুনি চিষ্টেম ফ\'ল্ডাৰ পিকাৰৰ জৰিয়তে বাছনি কৰা ফ\'ল্ডাৰসমূহত আপোনাৰ সংগীত ফাইলসমূহ থাকে।</string>
    <string name="data_storage_android_playback_title">এণ্ড্ৰইড পটভূমি প্লেবেক</string>
    <string name="data_storage_android_playback_body">যেতিয়া অডিঅ\' বজাই থাকে, ৰেট্ৰ\' প্লেয়াৰে এটা ফৰগ্ৰাউণ্ড মিডিয়া সেৱা চলায়, যাৰ ফলত আপুনি ফোন লক কৰিলেও বা অন্য এপলৈ গ\'লেও প্লেবেক চলি থাকে, আৰু চিষ্টেমৰ জাননীত ট্ৰান্সপ\'ৰ্ট কণ্ট্ৰ\'লসমূহ দেখা যায়। ৰিচেণ্টছৰ পৰা এপটো স্বাইপ কৰি আঁতৰালে প্লেবেক বন্ধ হয় আৰু জাননীখন আঁতৰাই পেলোৱা হয়।</string>
    <string name="data_storage_platform_body_android">এপৰ ডেটা ইন্টাৰনেল ষ্টোৰেজত থকা এপ-প্ৰাইভেট চাপৰ্ট এলেকাত সংৰক্ষণ কৰা হয়।</string>
