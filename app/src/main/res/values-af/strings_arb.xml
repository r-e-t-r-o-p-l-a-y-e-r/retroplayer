    <string name="data_storage">Databerging</string>
    <string name="data_storage_intro">Retro Player hou die app-instellings in \'n klein plaaslike databasis. Jou musiek en snitlyste bly as gewone lêers in vouers wat jy kies.</string>
    <string name="data_storage_app_data_title">App-databasis</string>
    <string name="data_storage_app_data_body">Lêer: %1$s\n   Pad: %2$s\n\n   Bewaar biblioteekwortels, blaartoestand, afspeelhervatting, gelykmaker, tema en taalvoorkeure.</string>
    <string name="data_storage_library_title">Musieklêers</string>
    <string name="data_storage_library_body">Oudio-lêers word nooit in die app-databasis gekopieer nie. Voeg biblioteekgidsen by en Retro Player lees lêers direk vanaf die skyf.</string>
    <string name="data_storage_playlists_title">Speellys-lêers</string>
    <string name="data_storage_playlists_body">Speellysies is gewone .m3u-lêers wat in jou biblioteekgidsies gestoor word. Jy kan hulle in die app of met enige teksaditor wysig.</string>
    <string name="data_storage_platform_title">Platform: %1$s</string>
    <string name="data_storage_android_permissions_title">Android-magtigings en berging</string>
    <string name="data_storage_android_native_body">Retro Player stoor sy databasis in die app-private ondersteuningsarea op interne berging. Jou musieklêers bly in vouers wat jy met die stelsel-vouerkeuser kies.</string>
    <string name="data_storage_android_playback_title">Android-agtergrondafspel</string>
    <string name="data_storage_android_playback_body">Wanneer klank afgespeel word, gebruik Retro Player \'n voorgrondmedia-diens sodat die afspeel voortgaan as jy die foon vergrendel of tussen toepassings wissel, met vervoerbeheer in die stelselnifikasie. Deur die app uit die Onlangse lys weg te vee, stop die afspeel en verwyder die kennisgewing.</string>
    <string name="data_storage_platform_body_android">App-data word gestoor in die privaat ondersteuningsarea van die app op interne stoorruimte.</string>
