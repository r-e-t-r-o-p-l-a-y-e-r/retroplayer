    <string name="data_storage">Kaydinta xogta</string>
    <string name="data_storage_intro">Retro Player waxay dejimaha abka ku haysaa kayd yar oo maxalli ah. Muusiggaaga iyo liisaska heesahaagu waxay ahaanayaan faylal caadi ah oo ku jira faylalka aad doorato.</string>
    <string name="data_storage_app_data_title">Xogta xogta abka</string>
    <string name="data_storage_app_data_body">Faylka: %1$s\nWadada: %2$s\n\nWaxay kaydisaa xididdada maktabadda, ka baadho xaaladda, resume-ka ciyaarta, barbardhigga, mawduuca, iyo doorbidyada luqadda.</string>
    <string name="data_storage_library_title">Faylasha muusikada</string>
    <string name="data_storage_library_body">Faylasha maqalka ah waligood laguma koobiyeyn karo xogta barnaamijka. Ku dar faylasha maktabadda, Retro Player-na wuxuu faylasha si toos ah uga akhriyaa diskka.</string>
    <string name="data_storage_playlists_title">Faylasha liiska heesaha</string>
    <string name="data_storage_playlists_body">Liisaska heesaha waa faylal caadi ah oo .m3u ah oo ku kaydsan faylalka maktabaddaada. Waxaad ku tafatiri kartaa abka ama tifaftire qoraal kasta.</string>
    <string name="data_storage_platform_title">Madal: %1$s</string>
    <string name="data_storage_android_permissions_title">Ruqsadaha iyo kaydinta Android</string>
    <string name="data_storage_android_native_body">Retro Player waxay kaydisaa xogteeda qaybta taageerada abka-gaarka ah ee kaydinta gudaha. Faylashaada muusiggu waxay ku sii jiraan faylalka aad doorato iyadoo la adeegsanayo soo-xulashada faylka nidaamka.</string>
    <string name="data_storage_android_playback_title">Ciyaarta asalka ah ee Android</string>
    <string name="data_storage_android_playback_body">Marka codku shaqeynayo, Retro Player wuxuu maamulaa adeeg warbaahineed oo hore sidaa darteed dib u ciyaarista ayaa sii socota haddii aad xirto taleefanka ama aad beddesho barnaamijyada, iyadoo kontaroolada gaadiidka ay ku jiraan ogeysiiska nidaamka. Ka fogeynta abka Recents waxay joojisaa dib u ciyaarista waxayna meesha ka saartaa ogeysiiska.</string>
    <string name="data_storage_platform_body_android">Xogta abka waxaa lagu kaydiyaa aagga taageerada abka-gaarka ah ee kaydinta gudaha.</string>
