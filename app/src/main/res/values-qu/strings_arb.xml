    <string name="data_storage">Willakuna waqaychay</string>
    <string name="data_storage_intro">Retro Playerqa aplicaciónpa kamachiyninkunata huk huch\'uylla kikinpa willay taqinpi waqaychan. Takiqniykikuna, taki qatiqninkunapas akllasqayki carpetakunapi sapsi willaykuna hina qhipanku.</string>
    <string name="data_storage_app_data_title">Aplicacionpa willaykuna t\'aqin</string>
    <string name="data_storage_app_data_body">Willañiqi: %1$s\nÑan: %2$s\n\nQillqa waqaychana, ñawinchay rikch\'ay, kutichiy qallariy, t\'ikraq, rikch\'ay, simi akllanakuna.</string>
    <string name="data_storage_library_title">Takiy willañiqikuna</string>
    <string name="data_storage_library_body">Uyarina willañiqikunaqa manan hayk\'aqpas app nisqap willañiqi waqaychananman kopiyakunchu. Bibliuteka karpitakunata yapay, chaywantaq Retro Player nisqaqa willañiqikunata disku nisqamanta chiqalla ñawirinqa.</string>
    <string name="data_storage_playlists_title">Takikuna qillqasqakuna</string>
    <string name="data_storage_playlists_body">Takikuna huñusqaqa qillqa mayt\'uykikuna ukhupi waqaychasqa ch\'usaq .m3u willañiqikunam. Chaykunataqa aplicacionpi utaq mayqin qillqa allichaqwanpas allichayta atinki.</string>
    <string name="data_storage_platform_title">Plataforma: %1$s</string>
    <string name="data_storage_android_permissions_title">Android saqillaykuna chaymanta waqaychana</string>
    <string name="data_storage_android_native_body">Retro Player nisqaqa willaykuna taqinta ukhu waqaychanapi, aplicaciónpa sapan yanapay k\'itichanpi waqaychan. Takiykuna archivoykikunaqa Sistemaq Carpetakuna Akllanawan akllasqayki carpetakunapim qhipan.</string>
    <string name="data_storage_android_playback_title">Androidpa qhipanpi waqachiy</string>
    <string name="data_storage_android_playback_body">Uyarina waqyachkaspaqa, Retro Player huk ñawpaq kaq media llamk\'ayta purichin, chaymi waqyachiyqa qatillan celularta wichq\'aspapas utaq huk aplicacionkunaman t\'ikraspapas, sistema willayninpitaq purichina kamachinakunayuq. Aplicacionta Qhipa kaqkunamanta qarquspaqa, waqyachiyta sayachin hinaspa willaytapas chinkachin.</string>
    <string name="data_storage_platform_body_android">Ruraypa willayninkunaqa ukhu waqaychanapi, ruraypa sapan yanapay k\'itipin waqaychasqa kashan.</string>
