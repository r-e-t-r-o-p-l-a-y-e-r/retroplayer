    <string name="data_storage">אחסון נתונים</string>
    <string name="data_storage_intro">Retro Player שומר את הגדרות האפליקציה במסד נתונים מקומי קטן. המוזיקה והפלייליסטים שלכם נשמרים כקובצים רגילים בתיקיות שתבחרו.</string>
    <string name="data_storage_app_data_title">מאגר האפליקציות</string>
    <string name="data_storage_app_data_body">קובץ: %1$s\nנתיב: %2$s\n\nמאחסן את שורשי הספריות, מצב הגלישה, המשך ההשמעה, האקולייזר, ערכת הנושא והעדפות השפה.</string>
    <string name="data_storage_library_title">קובצי מוזיקה</string>
    <string name="data_storage_library_body">קובצי אודיו לעולם אינם מועתקים למסד הנתונים של האפליקציה. הוסף תיקיות ספרייה, ו-Retro Player יקרא את הקבצים ישירות מהדיסק.</string>
    <string name="data_storage_playlists_title">קובצי רשימות השמעה</string>
    <string name="data_storage_playlists_body">רשימות השמעה הן קבצי .m3u פשוטים המאוחסנים בתיקיות הספרייה שלך. ניתן לערוך אותן באפליקציה או באמצעות כל עורך טקסט.</string>
    <string name="data_storage_platform_title">פלטפורמה: %1$s</string>
    <string name="data_storage_android_permissions_title">הרשאות ואחסון באנדרואיד</string>
    <string name="data_storage_android_native_body">Retro Player מאחסן את מסד הנתונים שלו באזור התמיכה הפרטי של האפליקציה, הנמצא באחסון הפנימי. קבצי המוזיקה שלך נשמרים בתיקיות שתבחר באמצעות בורר התיקיות של המערכת.</string>
    <string name="data_storage_android_playback_title">השמעה ברקע באנדרואיד</string>
    <string name="data_storage_android_playback_body">כאשר מתנגן אודיו, Retro Player מפעיל שירות מדיה ברקע, כך שההשמעה נמשכת גם אם נועלים את הטלפון או עוברים בין אפליקציות, כאשר פקדי ההשמעה מופיעים בהודעת המערכת. החלקה של האפליקציה מחוץ למסך \'האפליקציות האחרונות\' מפסיקה את ההשמעה ומסירה את ההודעה.</string>
    <string name="data_storage_platform_body_android">נתוני האפליקציה מאוחסנים באזור התמיכה הפרטי של האפליקציה בזיכרון הפנימי.</string>
