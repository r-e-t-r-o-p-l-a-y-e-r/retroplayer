    <string name="reset_database_title">לאפס את מסד הנתונים?</string>
    <string name="reset_database_body">פעולה זו מוחקת את מיקומי ההשמעה, את המועדפים, את התיקייה הפתוחה, את ערכת הנושא, את השפה ואת הגדרות האקולייזר. האפשרות \"נקה הכל\" מוחקת גם את תיקיות הספרייה שנוספו. קבצי המוזיקה ורשימות ההשמעה הנמצאים בדיסק אינם נמחקים.</string>
