    <string name="data_storage">Datu biltegiratzea</string>
    <string name="data_storage_intro">Retro Player-ek aplikazioaren ezarpenak datu-base lokal txiki batean gordetzen ditu. Zure musika eta playlistek hautatutako karpetetan fitxategi arrunt gisa geratzen dira.</string>
    <string name="data_storage_app_data_title">Aplikazioen datu-basea</string>
    <string name="data_storage_app_data_body">Fitxategia: %1$s\nBidea: %2$s\n\nDendak liburutegiko erroak, nabigazio-egoera, erreprodukzioaren berreskurapena, ekualizatzailea, gaia eta hizkuntza-aukerak.</string>
    <string name="data_storage_library_title">Musika-fitxategiak</string>
    <string name="data_storage_library_body">Audio-fitxategiak inoiz ez dira aplikazioaren datu-basean kopiatu. Gehitu liburutegiko karpetak, eta Retro Player-ek fitxategiak zuzenean diskoan irakurtzen ditu.</string>
    <string name="data_storage_playlists_title">Playlist fitxategiak</string>
    <string name="data_storage_playlists_body">Playlistak zure liburutegiko karpetetan gordeta dauden .m3u sinpleak dira. Aplikazioan edo edozein testu-editorekin editatu ditzakezu.</string>
    <string name="data_storage_platform_title">Plataforma: %1$s</string>
    <string name="data_storage_android_permissions_title">Android baimenak eta biltegiratzea</string>
    <string name="data_storage_android_native_body">Retro Player-ek bere datu-basea gordetzen du aplikazioaren pribatuko laguntza-eremuan, barne-biltegian. Zure musika-fitxategiak sistemaren karpeta-auketatzailearekin aukeratutako karpetetan geratzen dira.</string>
    <string name="data_storage_android_playback_title">Androideko atzeko planoan erreprodukzioa</string>
    <string name="data_storage_android_playback_body">Audioa erreproduzitzen ari denean, Retro Player-ek aurrealdeko media zerbitzu bat exekutatzen du, beraz erreprodukzioa jarraituko du telefonoa blokeatzen baduzu edo aplikazioak aldatzen badituzu, sistema jakinarazpenean garraio-kontrolak agertuz. Aplikazioa Berrientatik kendu ezkero, erreprodukzioa gelditzen da eta jakinarazpena desagertzen da.</string>
    <string name="data_storage_platform_body_android">Aplikazioaren datuak barne-biltegiko aplikazioaren pribatuko laguntza-eremuan gordetzen dira.</string>
