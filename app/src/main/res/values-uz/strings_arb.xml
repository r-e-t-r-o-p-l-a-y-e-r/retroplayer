    <string name="data_storage">Ma\'lumotlarni saqlash</string>
    <string name="data_storage_intro">Retro Player ilova sozlamalarini kichik mahalliy ma\'lumotlar bazasida saqlaydi. Musiqangiz va pleylistlaringiz siz tanlagan papkalardagi oddiy fayllar sifatida qoladi.</string>
    <string name="data_storage_app_data_title">Ilova ma\'lumotlar bazasi</string>
    <string name="data_storage_app_data_body">Fayl: %1$s\nYo\'l: %2$s\n\nKitobxona ildizlarini saqlash, ko\'rinish holatini ko\'rib chiqish, ijroni davom ettirish, ekvalayzer, mavzu va til sozlamalari.</string>
    <string name="data_storage_library_title">Musiqa fayllari</string>
    <string name="data_storage_library_body">Audio fayllar hech qachon ilovaning ma\'lumotlar bazasiga nusxalanmaydi. Kutubxona papkalarini qo\'shing va Retro Player fayllarni to\'g\'ridan-to\'g\'ri diskdan o\'qiydi.</string>
    <string name="data_storage_playlists_title">Playlist fayllari</string>
    <string name="data_storage_playlists_body">Playlistlar kutubxona papkalarida saqlangan oddiy .m3u fayllaridir. Ularni ilovada yoki istalgan matn muharririda tahrir qilishingiz mumkin.</string>
    <string name="data_storage_platform_title">Platforma: %1$s</string>
    <string name="data_storage_android_permissions_title">Android ruxsatnomalari va saqlash</string>
    <string name="data_storage_android_native_body">Retro Player o\'z ma\'lumotlar bazasini ilova uchun mo\'ljallangan maxsus qo\'llab-quvvatlash bo\'limida, ichki xotirada saqlaydi. Sizning musiqa fayllaringiz esa tizim papka tanlovchisi orqali tanlagan papkalarida qoladi.</string>
    <string name="data_storage_android_playback_title">Android fon ijrosi</string>
    <string name="data_storage_android_playback_body">Audio ijro etilayotganda, Retro Player old fondagi media xizmatini ishga tushiradi, shuning uchun telefonni qulflaganingizda yoki ilovalar o\'rtasida o\'tganingizda ijro davom etadi va transport boshqaruvlari bildirishnomada paydo bo\'ladi. Ilovani Yaqinlar ro\'yxatidan surib chiqarish ijroni to\'xtatadi va bildirishnomani olib tashlaydi.</string>
    <string name="data_storage_platform_body_android">Ilova ma\'lumotlari ichki saqlashdagi ilova xususiy yordam bo\'limida saqlanadi.</string>
