    <string name="data_storage_intro">Retro Player kenbe paramèt aplikasyon an nan yon ti baz done lokal. Mizik ou ak lis mizik ou yo rete kòm fichye nòmal nan dosye ou chwazi.</string>
    <string name="data_storage_app_data_title">Baz done aplikasyon</string>
    <string name="data_storage_app_data_body">Fichye: %1$s\nChemen: %2$s\n\nRasin bibliyotèk, eta navigasyon, reprann jwe, egalizè, tèm, ak preferans lang.</string>
    <string name="data_storage_library_title">Fichye mizik</string>
    <string name="data_storage_library_body">Fichye odyo yo pa janm kopye nan baz done aplikasyon an. Ajoute dosye bibliyotèk yo epi Retro Player li fichye yo dirèkteman sou disk la.</string>
    <string name="data_storage_playlists_title">Fichye lis mizik</string>
    <string name="data_storage_playlists_body">Playlists yo se senp fichye .m3u ki estoke nan dosye bibliyotèk ou yo. Ou ka modifye yo nan aplikasyon an oswa ak nenpòt editè tèks.</string>
    <string name="data_storage_platform_title">Platfòm: %1$s</string>
    <string name="data_storage_android_permissions_title">Pèmisyon ak depo Android</string>
    <string name="data_storage_android_native_body">Retro Player estoke baz done li nan zòn sipò prive aplikasyon an sou depo entèn. Fichye mizik ou yo rete nan dosye ou chwazi ak chwazè dosye sistèm nan.</string>
    <string name="data_storage_android_playback_title">Lekti an background sou Android</string>
    <string name="data_storage_android_playback_body">Lè odyo ap jwe, Retro Player kouri yon sèvis medya devan pou jwe a kontinye si ou bloke telefòn nan oswa chanje aplikasyon, ak kontwòl transpò nan notifikasyon sistèm nan. Lè ou glise aplikasyon an soti nan Resan yo, sa sispann jwe a epi retire notifikasyon an.</string>
    <string name="data_storage_platform_body_android">Done aplikasyon an estoke nan zòn sipò prive aplikasyon an sou depo entèn.</string>
