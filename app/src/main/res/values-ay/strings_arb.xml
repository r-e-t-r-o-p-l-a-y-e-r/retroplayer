    <string name="data_storage">Yatiyawinaka imaña</string>
    <string name="data_storage_intro">Retro Player ukax aplicación ukan wakiyäwinakap mä jisk\'a, manqhankir base de datos ukan imaski. Juman jayllinakama ukat jayllinakana listanakapas ajllit carpetanakana sapa uru archivonakjam qhiparaski.</string>
    <string name="data_storage_app_data_title">Aplicacionanaka ukan qillqatanakapa</string>
    <string name="data_storage_app_data_body">Qillqata: %1$s\nThakhi: %2$s\n\nImäwinaka, uñakipañ thakhi, qhipa uñt\'ayäwi, isapata, uñnaqa, ukat aru ajllitanaka.</string>
    <string name="data_storage_library_title">Jayllinaka</string>
    <string name="data_storage_library_body">Audio archivunakax janiw kuna pachas aplicación ukan base de datos ukarux copyatäkiti. Biblioteca carpetanak yapxatam, ukhamat Retro Player ukax archivunakax disco uksat chiqak liyt\'ani.</string>
    <string name="data_storage_playlists_title">Jayllinaka qillqatanaka</string>
    <string name="data_storage_playlists_body">Playlists ukax qhana .m3u archivunakawa, juman libreriaman carpetanakapan imatäki. Ukanakax aplicación ukana jan ukax kawkir qillqat liyt\'iri ukampis mayjt\'ayasmawa.</string>
    <string name="data_storage_platform_title">Sayt\'awi: %1$s</string>
    <string name="data_storage_android_permissions_title">Android iyaw sañanaka ukhamaraki imaña</string>
    <string name="data_storage_android_native_body">Retro Player ukax jupan base de datos ukxa manqha imañawin, aplicación-an privado yanapt\'awi chiqapan imi. Juman música archivonakamax sistema-n carpetas ajlliripampi ajllit carpetanakana qhipari.</string>
    <string name="data_storage_android_playback_title">Android qhipäxan uñacht\'ayaña</string>
    <string name="data_storage_android_playback_body">Audio ist\'askäna ukhaxa, Retro Player ukax nayraqatankir mä media irnaqäwi apnaqi, ukhamat celular jist\'antkasasa jan ukax yaqha app-anakaru mantkasasa ist\'añax sarantaskakiñapataki, sistema yatiyäwin apnaqañanakampi. App-aru Recents uksat jaquntxäta ukhaxa, ist\'añax sayt\'iwa ukat yatiyäwipas chhaqtayarakiwa.</string>
    <string name="data_storage_platform_body_android">App-an datonakapax manqha imañawin, app-an sapaki yanapt\'awi chiqan imatawa.</string>
