    <string name="data_storage">Okutereka amawulire</string>
    <string name="data_storage_intro">Retro Player ekuuma ensengeka za app mu database entono ey’omu kitundu. Ennyimba zo n’enkalala z’okuyimba bisigala nga fayiro eza bulijjo mu folda z’olonze.</string>
    <string name="data_storage_app_data_title">Database ya app</string>
    <string name="data_storage_app_data_body">Fayiro: %1$s\nEkkubo: %2$s\n\nEtereka emirandira gy\'etterekero, embeera y\'okutambula, okuddamu okuzannya, ekyenkanya, omulamwa, n\'olulimi lw\'oyagala.</string>
    <string name="data_storage_library_title">Fayiro z’ennyimba</string>
    <string name="data_storage_library_body">Fayiro z’amaloboozi tezikoppololwako mu database ya app. Okwongerako ebitabo by’etterekero ly’ebitabo era Retro Player esoma fayiro butereevu okuva ku disiki.</string>
    <string name="data_storage_playlists_title">Fayiro z’olukalala lw’okuyimba</string>
    <string name="data_storage_playlists_body">Enkalala z’okuyimba fayiro za .m3u eza bulijjo eziterekeddwa munda mu bitabo byo eby’etterekero ly’ebitabo. Osobola okuzirongoosa mu app oba ne text editor yonna.</string>
    <string name="data_storage_platform_title">Omukutu: %1$s</string>
    <string name="data_storage_android_permissions_title">Olukusa lwa Android n\'okutereka</string>
    <string name="data_storage_android_native_body">Retro Player etereka database yaayo mu kitundu ky\'obuyambi bwa app-private ku kutereka okw\'omunda. Fayiro zo ez\'ennyimba zisigala mu folda z\'olonda n\'omulonda folda z\'enkola.</string>
    <string name="data_storage_android_playback_title">Android okuzannya mugongo</string>
    <string name="data_storage_android_playback_body">Amaloboozi bwe gakuba, Retro Player ekola empeereza y’emikutu gy’amawulire egy’omu maaso kale okuzannya kugenda mu maaso singa osiba essimu oba okyusa apps, ng’olina ebifuga entambula mu kumanyisibwa kw’enkola. Bw’osika app okuva ku Recents kiyimiriza okuzannya era kiggyawo okumanyisibwa.</string>
    <string name="data_storage_platform_body_android">Data ya app eterekebwa mu kitundu ky’obuyambi bwa app-private ku kutereka okw’omunda.</string>
