    <string name="data_storage">Gagnageymsla</string>
    <string name="data_storage_intro">Retro Player geymir stillingar forritsins í litlum staðbundnum gagnagrunni. Tónlistin þín og spilunarlistarnir þínir eru venjulegar skrár í möppum sem þú velur.</string>
    <string name="data_storage_app_data_title">Gagnagrunnur forritsins</string>
    <string name="data_storage_app_data_body">Skrá: %1$s\nSlóður: %2$s\n\nGeymir bókasafnsrætur, vafraástand, endurspilunarendurupptöku, tónjafnara, þema og tungumálastillingar.</string>
    <string name="data_storage_library_title">Tónlistarskrár</string>
    <string name="data_storage_library_body">Hljóðskrár eru aldrei afritaðar í gagnagrunn forritsins. Bættu við möppum bókasafnsins og Retro Player les skrár beint af diski.</string>
    <string name="data_storage_playlists_title">Spilunarlista skrár</string>
    <string name="data_storage_playlists_body">Spilunarlistar eru einfaldar .m3u-skrár sem geymdar eru í bókasafnsmöppum þínum. Þú getur breytt þeim í forritinu eða með hvaða textaritli sem er.</string>
    <string name="data_storage_platform_title">Vettvangur: %1$s</string>
    <string name="data_storage_android_permissions_title">Android heimildir og geymsla</string>
    <string name="data_storage_android_native_body">Retro Player geymir gagnagrunn sinn á einkasvæði forritsstuðnings á innri geymslu. Tónlistarskrár þínar verða áfram í möppum sem þú velur með kerfisvalsara möppna.</string>
    <string name="data_storage_android_playback_title">Android bakgrunnsspilun</string>
    <string name="data_storage_android_playback_body">Þegar hljóð er í spilun keyrir Retro Player forgrunnsmiðlunarþjónustu svo spilun haldi áfram þótt þú læsir símanum eða skiptir um forrit, með spilunarstýringum í kerfistilkynningunni. Með því að fletta forritinu út úr nýjustu forritunum stöðvarðu spilun og fjarlægir tilkynninguna.</string>
    <string name="data_storage_platform_body_android">Gögn forritsins eru geymd á einkasvæði forritsstuðnings á innri geymslu.</string>
