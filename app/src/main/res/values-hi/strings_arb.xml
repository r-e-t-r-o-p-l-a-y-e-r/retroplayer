    <string name="data_storage">डेटा संग्रहण</string>
    <string name="data_storage_intro">रेट्रो प्लेयर एक छोटे स्थानीय डेटाबेस में ऐप सेटिंग रखता है। आपके द्वारा चुने गए फ़ोल्डरों में आपका संगीत और प्लेलिस्ट सामान्य फ़ाइलों की तरह बने रहते हैं।</string>
    <string name="data_storage_app_data_title">ऐप डेटाबेस</string>
    <string name="data_storage_app_data_body">फ़ाइल: %1$s\nपथ: %2$s\n\nलाइब्रेरी की जड़ें संग्रहीत करता है, राज्य ब्राउज़ करता है, प्लेबैक फिर से शुरू करता है, तुल्यकारक, थीम और भाषा प्राथमिकताएं संग्रहीत करता है।</string>
    <string name="data_storage_library_title">म्यूज़िक फ़ाइलें</string>
    <string name="data_storage_library_body">ऑडियो फ़ाइलों को कभी भी ऐप डेटाबेस में कॉपी नहीं किया जाता है। लाइब्रेरी फ़ोल्डर जोड़ें और रेट्रो प्लेयर सीधे डिस्क से फ़ाइलें पढ़ता है।</string>
    <string name="data_storage_playlists_title">प्लेलिस्ट फ़ाइलें</string>
    <string name="data_storage_playlists_body">प्लेलिस्ट आपके लाइब्रेरी फ़ोल्डर्स के अंदर संग्रहीत सादे .m3u फ़ाइलें हैं। आप उन्हें ऐप में या किसी भी टेक्स्ट एडिटर के साथ एडिट कर सकते हैं।</string>
    <string name="data_storage_platform_title">प्लैटफ़ॉर्म: %1$s</string>
    <string name="data_storage_android_permissions_title">एंड्रॉइड की अनुमतियाँ और स्टोरेज</string>
    <string name="data_storage_android_native_body">रेट्रो प्लेयर अपने डेटाबेस को ऐप - प्राइवेट सपोर्ट एरिया में इंटरनल स्टोरेज पर स्टोर करता है। आपकी म्यूज़िक फ़ाइलें उन फ़ोल्डरों में रहती हैं जिन्हें आप सिस्टम फ़ोल्डर पिकर के साथ चुनते हैं।</string>
    <string name="data_storage_android_playback_title">एंड्रॉइड बैकग्राउंड प्लेबैक</string>
    <string name="data_storage_android_playback_body">जब ऑडियो चल रहा होता है, तो रेट्रो प्लेयर एक अग्रभूमि मीडिया सेवा चलाता है, इसलिए यदि आप सिस्टम अधिसूचना में परिवहन नियंत्रण के साथ फोन को लॉक करते हैं या ऐप स्विच करते हैं, तो प्लेबैक जारी रहता है। ऐप को Recents से दूर स्वाइप करने से प्लेबैक बंद हो जाता है और नोटिफ़िकेशन हटा दिया जाता है।</string>
    <string name="data_storage_platform_body_android">ऐप डेटा को ऐप - प्राइवेट सपोर्ट एरिया में इंटरनल स्टोरेज पर स्टोर किया जाता है।</string>
