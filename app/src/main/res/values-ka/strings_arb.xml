    <string name="data_storage_intro">Retro Player აპლიკაციის პარამეტრებს მცირე ლოკალურ მონაცემთა ბაზაში ინახავს. თქვენი მუსიკა და პლეისლისტები ჩვეულებრივ ფაილებად რჩება თქვენ მიერ არჩეულ საქაღალდეებში.</string>
    <string name="data_storage_app_data_title">აპლიკაციის მონაცემთა ბაზა</string>
    <string name="data_storage_app_data_body">ფაილი: %1$s\nგზა: %2$s\n\nმაღაზიის ბიბლიოთეკის პარამეტრები, ნაგულისხმევი მდგომარეობა, დაკვრის განახლება, ეკვალაიზერი, თემა და ენის პარამეტრები.</string>
    <string name="data_storage_library_title">მუსიკალური ფაილები</string>
    <string name="data_storage_library_body">აუდიო ფაილები არასდროს კოპირდება აპლიკაციის მონაცემთა ბაზაში. დაამატეთ ბიბლიოთეკის საქაღალდეები და Retro Player ფაილებს პირდაპირ დისკიდან კითხულობს.</string>
    <string name="data_storage_playlists_title">პლეისლის ფაილები</string>
    <string name="data_storage_playlists_body">პლეისლისტები უბრალო .m3u ფაილებია, რომლებიც თქვენი ბიბლიოთეკის საქაღალდეებში ინახება. მათი რედაქტირება შეგიძლიათ აპლიკაციაში ან ნებისმიერი ტექსტური რედაქტორის მეშვეობით.</string>
    <string name="data_storage_platform_title">პლატფორმა: %1$s</string>
    <string name="data_storage_android_permissions_title">Android-ის ნებართვები და საცავი</string>
    <string name="data_storage_android_native_body">Retro Player-ი თავის მონაცემთა ბაზას შიდა მეხსიერებაში, აპლიკაციის კერძო მხარდაჭერის არეალში ინახავს. თქვენი მუსიკალური ფაილები რჩება იმ საქაღალდეებში, რომლებსაც სისტემის საქაღალდეების ამომრჩევლით აირჩევთ.</string>
    <string name="data_storage_android_playback_title">Android-ის ფონური დაკვრა</string>
    <string name="data_storage_android_playback_body">როდესაც აუდიო უკრავს, Retro Player-ი უძრავ მულტიმედიურ სერვისს უშვებს, რათა დაკვრა გაგრძელდეს ტელეფონის ჩაკეტვის ან აპლიკაციების შეცვლის შემთხვევაში, სისტემური შეტყობინების ზოლში არსებული მართვის ღილაკებით. აპლიკაციის ახალი აპლიკაციების სიიდან წაშლით დაკვრა ჩერდება და შეტყობინება იშლება.</string>
    <string name="data_storage_platform_body_android">აპლიკაციის მონაცემები ინახება შიდა მეხსიერებაზე, აპლიკაციის კერძო საცავში.</string>
