    <string name="data_storage">Panyimpenan data</string>
    <string name="data_storage_intro">Retro Player nyimpen setélan aplikasi dina basis data lokal anu leutik. Musik jeung daptar puter anjeun tetep jadi file biasa dina folder anu anjeun pilih.</string>
    <string name="data_storage_app_data_title">Database aplikasi</string>
    <string name="data_storage_app_data_body">File: %1$s\nJejak: %2$s\n\nNyimpen setélan perpustakaan, status panyungsi, neruskeun playback, equalizer, téma, jeung preferensi basa.</string>
    <string name="data_storage_library_title">File musik</string>
    <string name="data_storage_library_body">File audio moal kungsi disalin kana basis data aplikasi. Tambahkeun folder perpustakaan, teras Retro Player maca file langsung tina disk.</string>
    <string name="data_storage_playlists_title">File daptar lagu</string>
    <string name="data_storage_playlists_body">Playlist téh file .m3u basajan anu disimpen di jero folder perpustakaan anjeun. Anjeun tiasa ngéditna dina aplikasi atawa ku éditor téks naon waé.</string>
    <string name="data_storage_platform_title">Platform: %1$s</string>
    <string name="data_storage_android_permissions_title">Izin sareng panyimpenan Android</string>
    <string name="data_storage_android_native_body">Retro Player nyimpen basis data na di wewengkon dukungan pribadi aplikasi dina panyimpenan internal. Berkas musik anjeun tetep aya dina folder anu anjeun pilih ngaliwatan pemilih folder sistem.</string>
    <string name="data_storage_android_playback_title">Pamaén latar Android</string>
    <string name="data_storage_android_playback_body">Nalika audio keur maén, Retro Player ngajalankeun layanan média hareup sangkan pamuteran tetep lumangsung sanajan anjeun ngunci telepon atawa ngalih ka aplikasi séjén, kalayan kontrol pamuter dina béwara sistem. Ngusap aplikasi kaluar tina Anyar eureunkeun pamuteran jeung ngahapus béwara.</string>
    <string name="data_storage_platform_body_android">Data aplikasi disimpen di wewengkon dukungan pribadi aplikasi dina panyimpenan internal.</string>
