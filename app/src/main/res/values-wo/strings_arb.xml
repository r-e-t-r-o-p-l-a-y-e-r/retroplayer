    <string name="data_storage">Denc xibaar</string>
    <string name="data_storage_intro">Retro Player dafay denc réglage application bi ci benn base de données bu ndaw bu nekk ci sa telefon. Sa woy yi ak sa playlist yi dañuy deséni niki ay fisiye yu normal ci ay dossier yoo tànn.</string>
    <string name="data_storage_app_data_title">Dàttabàsu aplikasiyoŋ</string>
    <string name="data_storage_app_data_body">Dosye: %1$s\nYoon: %2$s\n\nDencukaayu library, melokaanu seet, wéyal wàllu taal, egalisaatër, tém, ak tànneefi làkk.</string>
    <string name="data_storage_library_title">Dosiye misik</string>
    <string name="data_storage_library_body">Fichiye odiyo yi, duñu leen mukk koppiye ci biir database aplikasion bi. Yokkal dosiyeeri bibliyotek yi, te Retro Player dina jàng fichiye yi direk ci disk bi.</string>
    <string name="data_storage_playlists_title">Dosiye yu playlist yi</string>
    <string name="data_storage_playlists_body">Playlists yi ay fisiye .m3u yu ñagas lañu rekk, yu nekk ci biir say dosiye bibliyotek. Mën nga leen soppi ci aplikasion bi walla ak bépp éditeur de tèks.</string>
    <string name="data_storage_platform_title">Palaform: %1$s</string>
    <string name="data_storage_android_permissions_title">Saytu Android ak dencukaay</string>
    <string name="data_storage_android_native_body">Retro Player dafay denc database-am ci barab bu ñu jagleel aplikasion bi ci dencukaay bu biir bi. Say fisiye woy dañuy des ci dosye yi nga tànn ak jumtukaayu tànn dosye bu sistem bi.</string>
    <string name="data_storage_android_playback_title">Wéyal ci ginnaaw ci Android</string>
    <string name="data_storage_android_playback_body">Su kàddu di dox, Retro Player dafay doxal ab servis media bu jiitu, kon doxal gi day wéy sax boo tëjee telefon bi walla nga soppi aplikasioŋ, te saytuukaay yi di feeñ ci notifikasioŋ sistem bi. Boo frotee aplikasioŋ bi génne ko ci \'Recents\', doxal gi day taxaw te notifikasioŋ bi di ñàkk.</string>
    <string name="data_storage_platform_body_android">Xibaari aplikasion bi dañu ko denc ci barab bu ñu jagleel aplikasion bi ci dencukaay biir.</string>
