    <string name="data_storage">Kuchengetedza data</string>
    <string name="data_storage_intro">Retro Player inochengetedza marongero eapp mudhatabhesi diki remunharaunda. Mimhanzi yako nenziyo dzekutamba zvinoramba zviri mafaira akajairwa mumaforodha aunosarudza.</string>
    <string name="data_storage_app_data_title">Dhatabhesi remapurogiramu</string>
    <string name="data_storage_app_data_body">Faira: %1$s\nNzira: %2$s\n\nInochengetedza midzi yeraibhurari, mamiriro ekutsvaga, CV yekutamba, equalizer, dingindira, uye zvaunofarira mumitauro.</string>
    <string name="data_storage_library_title">Mafaira emimhanzi</string>
    <string name="data_storage_library_body">Mafaira eaudio haambokopwa mudhatabhesi reapp. Wedzera maforodha eraibhurari uye Retro Player inoverenga mafaira zvakananga kubva padhisiki.</string>
    <string name="data_storage_playlists_title">Mafaira emitambo yekutamba</string>
    <string name="data_storage_playlists_body">Maplaylist mafaira e .m3u akachengetwa mumaforodha eraibhurari yako. Unogona kuagadzirisa muapp kana nechero text editor.</string>
    <string name="data_storage_platform_title">Puratifomu: %1$s</string>
    <string name="data_storage_android_permissions_title">Mvumo nekuchengetedza zveAndroid</string>
    <string name="data_storage_android_native_body">Retro Player inochengeta dhatabhesi yayo munzvimbo yekutsigira yeapp-yakavanzika pane yekuchengetera mukati. Mafaira ako emimhanzi anogara mumafolda aunosarudza nesystem folder picker.</string>
    <string name="data_storage_android_playback_title">Kutamba kumashure kweAndroid</string>
    <string name="data_storage_android_playback_body">Kana odhiyo ichirira, Retro Player inoshandisa sevhisi yemedia yekumberi saka kutamba kunoramba kuchienderera mberi kana ukakiya foni kana kuchinja maapplication, netransport controls musystem notification. Kubvisa app kubva kuRecents kunomisa kutamba uye kunobvisa chiziviso.</string>
    <string name="data_storage_platform_body_android">Ruzivo rweapp runochengetwa munzvimbo yekutsigira yeapp-yakavanzika pane yekuchengetera mukati.</string>
