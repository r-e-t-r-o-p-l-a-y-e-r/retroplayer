    <string name="data_storage">ডেটা স্টোরেজ</string>
    <string name="data_storage_intro">রেট্রো প্লেয়ার একটি ছোট স্থানীয় ডাটাবেসে অ্যাপ সেটিংস রাখে । আপনার সঙ্গীত এবং প্লেলিস্টগুলি আপনার বেছে নেওয়া ফোল্ডারে স্বাভাবিক ফাইল হিসাবে থাকে ।</string>
    <string name="data_storage_app_data_title">অ্যাপ ডেটাবেস</string>
    <string name="data_storage_app_data_body">ফাইল: %1$s\nপথ: %2$s\n\nস্টোর লাইব্রেরির শিকড়, ব্রাউজ স্টেট, প্লেব্যাক সারসংকলন, ইকুয়ালাইজার, থিম এবং ভাষার পছন্দ ।</string>
    <string name="data_storage_library_title">মিউজিক ফাইল</string>
    <string name="data_storage_library_body">অডিও ফাইলগুলি কখনই অ্যাপ ডেটাবেসে অনুলিপি করা হয় না । লাইব্রেরি ফোল্ডার যোগ করুন এবং রেট্রো প্লেয়ার ডিস্ক থেকে সরাসরি ফাইল পড়ে ।</string>
    <string name="data_storage_playlists_title">প্লেলিস্ট ফাইল</string>
    <string name="data_storage_playlists_body">প্লেলিস্টগুলি আপনার লাইব্রেরি ফোল্ডারের মধ্যে সংরক্ষিত প্লেইন .m3u ফাইল । আপনি এগুলি অ্যাপে বা যে কোনও টেক্সট এডিটর দিয়ে এডিট করতে পারেন ।</string>
    <string name="data_storage_platform_title">প্ল্যাটফর্ম: %1$s</string>
    <string name="data_storage_android_permissions_title">অ্যান্ড্রয়েডের অনুমতি এবং স্টোরেজ</string>
    <string name="data_storage_android_native_body">রেট্রো প্লেয়ার অভ্যন্তরীণ স্টোরেজে অ্যাপ-প্রাইভেট সাপোর্ট এরিয়াতে তার ডাটাবেস সংরক্ষণ করে । আপনার মিউজিক ফাইলগুলি সিস্টেম ফোল্ডার পিকারের সাথে আপনার বেছে নেওয়া ফোল্ডারে থাকে ।</string>
    <string name="data_storage_android_playback_title">অ্যান্ড্রয়েড ব্যাকগ্রাউন্ড প্লেব্যাক</string>
    <string name="data_storage_android_playback_body">অডিও বাজানোর সময়, রেট্রো প্লেয়ার একটি অগ্রভূমির মিডিয়া পরিষেবা চালায় তাই আপনি যদি ফোন লক করেন বা সিস্টেম বিজ্ঞপ্তিতে পরিবহন নিয়ন্ত্রণ সহ অ্যাপ্লিকেশনগুলি স্যুইচ করেন তবে প্লেব্যাক চলতে থাকে । রিডেন্টস থেকে অ্যাপটিকে দূরে সোয়াইপ করা প্লেব্যাক বন্ধ করে দেয় এবং বিজ্ঞপ্তি সরিয়ে দেয় ।</string>
    <string name="data_storage_platform_body_android">অ্যাপের ডেটা অভ্যন্তরীণ স্টোরেজে অ্যাপ-প্রাইভেট সাপোর্ট এরিয়াতে সংরক্ষণ করা হয় ।</string>
