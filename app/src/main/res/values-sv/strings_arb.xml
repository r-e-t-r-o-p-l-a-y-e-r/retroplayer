    <string name="data_storage">Datalagring</string>
    <string name="data_storage_intro">Retro Player sparar appinställningarna i en liten lokal databas. Din musik och dina spellistor förblir vanliga filer i de mappar du väljer.</string>
    <string name="data_storage_app_data_title">Appdatabas</string>
    <string name="data_storage_app_data_body">Fil: %1$s\nSökväg: %2$s\n\nHär sparas inställningar för bibliotekets rotkataloger, bläddringsläge, återuppspelning, equalizer, tema och språk.</string>
    <string name="data_storage_library_title">Musikfiler</string>
    <string name="data_storage_library_body">Ljudfiler kopieras aldrig till appens databas. Lägg till biblioteksmappar så läser Retro Player filerna direkt från hårddisken.</string>
    <string name="data_storage_playlists_title">Spellistfiler</string>
    <string name="data_storage_playlists_body">Spellistor är vanliga .m3u-filer som lagras i dina biblioteksmappar. Du kan redigera dem i appen eller med valfri textredigerare.</string>
    <string name="data_storage_platform_title">Plattform: %1$s</string>
    <string name="data_storage_android_permissions_title">Android-behörigheter och lagringsutrymme</string>
    <string name="data_storage_android_native_body">Retro Player lagrar sin databas i appens privata supportområde på det interna lagringsutrymmet. Dina musikfiler förblir i de mappar du väljer med systemets mappväljare.</string>
    <string name="data_storage_android_playback_title">Uppspelning i bakgrunden på Android</string>
    <string name="data_storage_android_playback_body">När ljud spelas upp kör Retro Player en medietjänst i förgrunden, så att uppspelningen fortsätter även om du låser telefonen eller byter app. Kontrollerna för uppspelningen visas i systemmeddelandet. Om du sveper bort appen från listan över senaste appar avbryts uppspelningen och meddelandet försvinner.</string>
    <string name="data_storage_platform_body_android">Appdata lagras i det appspecifika stödområdet på det interna lagringsutrymmet.</string>
