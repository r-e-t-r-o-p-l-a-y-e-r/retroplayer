    <string name="data_storage">Stóráil sonraí</string>
    <string name="data_storage_intro">Coinníonn Retro Player socruithe na haipe i mbunachar sonraí beag áitiúil. Fánann do chuid ceoil agus do liostaí seinnte mar ghnáthchomhaid i bhfillteáin a roghnaíonn tú.</string>
    <string name="data_storage_app_data_title">Bunachar sonraí na haipe</string>
    <string name="data_storage_app_data_body">Comhad: %1$s\nConair: %2$s\n\nStórálann sé fréamhacha na leabharlainne, an staid brabhsála, athsheinm a athshlánú, an comhionannán, an téama, agus roghanna teanga.</string>
    <string name="data_storage_library_title">Comhaid ceoil</string>
    <string name="data_storage_library_body">Ní dhéantar comhaid fuaime a chóipeáil isteach i mbunachar sonraí an aip riamh. Cuir fillteáin leabharlainne leis agus léann Retro Player comhaid go díreach ón diosca.</string>
    <string name="data_storage_playlists_title">Comhaid liosta seinnte</string>
    <string name="data_storage_playlists_body">Is comhaid .m3u gnáth iad na liostaí seinnte a stóráiltear i bhfillteáin do leabharlainne. Is féidir leat iad a chur in eagar san aip nó le haon eagarthóir téacs.</string>
    <string name="data_storage_platform_title">Ardán: %1$s</string>
    <string name="data_storage_android_permissions_title">Ceadanna agus stóráil Android</string>
    <string name="data_storage_android_native_body">Stórálann Retro Player a bhunachar sonraí sa limistéar tacaíochta príobháideach aipe ar an stóráil inmheánach. Fanann do chuid comhad ceoil sna fillteáin a roghnaíonn tú le roghnóir fillteán an chórais.</string>
    <string name="data_storage_android_playback_title">Seinm cúlra Android</string>
    <string name="data_storage_android_playback_body">Nuair a bhíonn fuaim á sheinm, ritheann Retro Player seirbhís meán tosaigh ionas go leanann an t-aisamhrán ar aghaidh má ghlasálann tú an fón nó má aistríonn tú idir aipeanna, le rialtáin iompair san fhógra córais. Má shleamhnaíonn tú an aip amach as \'Le déanaí\', stopann an t-aisamhrán agus baintear an fógra.</string>
    <string name="data_storage_platform_body_android">Stóráiltear sonraí na haipe sa limistéar tacaíochta príobháideach don aip ar an stóráil inmheánach.</string>
