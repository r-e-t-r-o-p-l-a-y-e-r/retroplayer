    <string name="data_storage">Panyimpenan data</string>
    <string name="data_storage_intro">Retro Player nyimpen setelan aplikasi ing basis data lokal sing cilik. Musik lan dhaptar putarmu tetep dadi file biasa ing folder sing kowe pilih.</string>
    <string name="data_storage_app_data_title">Database aplikasi</string>
    <string name="data_storage_app_data_body">File: %1$s\nJalan: %2$s\n\nNyimpen root perpustakaan, negara bagian jelajah, sambungake mbaleni puter, equalizer, tema, lan preferensi basa.</string>
    <string name="data_storage_library_title">Berkas musik</string>
    <string name="data_storage_library_body">File audio ora tau disalin menyang basis data aplikasi. Tambahake folder perpustakaan lan Retro Player maca file langsung saka disk.</string>
    <string name="data_storage_playlists_title">Berkas daftar lagu</string>
    <string name="data_storage_playlists_body">Playlist iku file .m3u biasa sing disimpen ing folder perpustakaanmu. Kowe bisa nyunting ing aplikasi utawa nganggo sembarang editor teks.</string>
    <string name="data_storage_platform_title">Platform: %1$s</string>
    <string name="data_storage_android_permissions_title">Ijin Android lan panyimpenan</string>
    <string name="data_storage_android_native_body">Retro Player nyimpen basis data ing area dhukungan pribadi aplikasi ing panyimpenan internal. Berkas musik sampeyan tetep ana ing folder sing sampeyan pilih nganggo pemilih folder sistem.</string>
    <string name="data_storage_android_playback_title">Pemutaran latar mburi Android</string>
    <string name="data_storage_android_playback_body">Nalika audio lagi diputer, Retro Player mbukak layanan media ing latar ngarep supaya pemutaran terus lumaku sanajan sampeyan ngunci telpon utawa ngalih aplikasi, kanthi kontrol pemutaran ing kabar sistem. Ngeser aplikasi metu saka Recents bakal mandhegake pemutaran lan mbusak kabar.</string>
    <string name="data_storage_platform_body_android">Data aplikasi disimpen ing area dhukungan pribadi aplikasi ing panyimpenan internal.</string>
