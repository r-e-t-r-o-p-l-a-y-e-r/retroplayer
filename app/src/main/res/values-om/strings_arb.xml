    <string name="data_storage">Kuusaa ragaa</string>
    <string name="data_storage_intro">Retro Player qindaa\'ina appii kuusaa daataa xiqqaa naannoo keessatti kuusa. Muuziqaa kee fi tarree taphaa kee akka faayiloota idileetti galmee ati filatte keessatti turu.</string>
    <string name="data_storage_app_data_title">Kuusaa Appilikeeshinii</string>
    <string name="data_storage_app_data_body">Faayilii: %1$s\nDaandii: %2$s\n\nKuusaa mana kitaabaa, haala sakatta\'uu, itti fufsiisuu taphachiisaa, walqixxeessituu, mata duree, fi filannoowwan afaanii.</string>
    <string name="data_storage_library_title">Faayiloota muuziqaa</string>
    <string name="data_storage_library_body">Faayiloonni sagalee gonkumaa kuusaa appilikeeshinichaa keessatti hin garagalaman. Galmeewwan mana kitaabaa itti dabali, Retro Player faayiloota kallattiin diskii irraa dubbisa.</string>
    <string name="data_storage_playlists_title">Faayiloota tarree taphaa</string>
    <string name="data_storage_playlists_body">Tarreen weelluuwwanii faayiloota .m3u salphaa kan galmee kitaabxana keessan keessa kuufamanidha. Appilikeeshinii keessatti yookaan gulaalaa barruu kamiyyuu fayyadamuun isaan gulaaluu dandeessu.</string>
    <string name="data_storage_platform_title">Dirii: %1$s</string>
    <string name="data_storage_android_permissions_title">Hayyamoota Androidii fi Kuusaa</string>
    <string name="data_storage_android_native_body">Retro Player kuusaa odeeffannoo isaa kuusaa keessoo irratti, kutaa deeggarsaa app-iif dhuunfaa ta\'e keessatti kuusa. Faayiloonni muuziqaa keessan galmeewwan filata galmee sirnaatiin filattan keessatti turu.</string>
    <string name="data_storage_android_playback_title">Taphachiisa duubaa Andirooyidii</string>
    <string name="data_storage_android_playback_body">Yeroo sagaleen taphachaa jiru, Retro Player tajaajila miidiyaa fuulduraa kan hojjetu yoo ta\'u, kunis yoo bilbila keessan cufattan yookaan app jijjiirtan taphachiisuun akka itti fufu taasisa, to\'annoowwan geejjibaa beeksisa sirnaa keessatti argamuun. Appii sana tarree \'Recents\' irraa haquun taphachiisuu ni dhaabsa akkasumas beeksisicha ni balleessa.</string>
    <string name="data_storage_platform_body_android">Daataan appilikeeshinii kuusaa keessoo irratti, naannoo deeggarsaa dhuunfaa appilikeeshinii keessatti kuufama.</string>
