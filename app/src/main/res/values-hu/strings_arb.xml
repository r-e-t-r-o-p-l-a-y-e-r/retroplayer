    <string name="data_storage">Adattárolás</string>
    <string name="data_storage_intro">A Retro Player az alkalmazás beállításait egy kis helyi adatbázisban tárolja. A zenéid és a lejátszási listáid továbbra is hagyományos fájlként maradnak az általad kiválasztott mappákban.</string>
    <string name="data_storage_app_data_title">Alkalmazás-adatbázis</string>
    <string name="data_storage_app_data_body">Fájl: %1$s\nÚtvonal: %2$s\n\nA könyvtárak gyökérkönyvtárait, a böngészési állapotot, a lejátszás folytatását, az ekvalizert, a témát és a nyelvi beállításokat tárolja.</string>
    <string name="data_storage_library_title">Zenefájlok</string>
    <string name="data_storage_library_body">Az audiofájlok soha nem kerülnek átmásolásra az alkalmazás adatbázisába. Ha hozzáadsz könyvtármappákat, a Retro Player közvetlenül a lemezről olvassa be a fájlokat.</string>
    <string name="data_storage_playlists_title">Lejátszási lista fájlok</string>
    <string name="data_storage_playlists_body">A lejátszási listák egyszerű .m3u fájlok, amelyek a könyvtármappáidban vannak tárolva. Szerkesztheted őket az alkalmazásban vagy bármilyen szövegszerkesztővel.</string>
    <string name="data_storage_platform_title">Platform: %1$s</string>
    <string name="data_storage_android_permissions_title">Android-jogosultságok és tárhely</string>
    <string name="data_storage_android_native_body">A Retro Player az adatbázisát a belső tárhelyen található, az alkalmazás számára fenntartott támogatási területen tárolja. A zenefájlok a rendszer mappaválasztójával kiválasztott mappákban maradnak.</string>
    <string name="data_storage_android_playback_title">Hanglejátszás háttérben Androidon</string>
    <string name="data_storage_android_playback_body">Hangfájl lejátszása közben a Retro Player egy előtérbeli médiaszolgáltatást futtat, így a lejátszás folytatódik akkor is, ha lezárja a telefont vagy másik alkalmazásra vált; a lejátszásvezérlők pedig a rendszer értesítési sávjában jelennek meg. Ha az alkalmazást elhúzza a „Legutóbbi alkalmazások” listájából, a lejátszás leáll, és az értesítés is eltűnik.</string>
    <string name="data_storage_platform_body_android">Az alkalmazás adatai a belső tárhelyen, az alkalmazás saját támogatási területén kerülnek tárolásra.</string>
