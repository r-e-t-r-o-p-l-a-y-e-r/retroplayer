    <string name="data_storage">Ukugcinwa kwedatha</string>
    <string name="data_storage_intro">Retro Player igcina izilungiselelo ze-app kudathabheyisi encane yasendaweni. Umculo wakho namaluhlu okudlalwayo zihlala njengefayela evamile emafolda owazikhethayo.</string>
    <string name="data_storage_app_data_title">Idathabheyisi yohlelo lokusebenza</string>
    <string name="data_storage_app_data_body">Ifayela: %1$s\nIndlela: %2$s\n\nIzimpande zezitolo, isimo sokubuka, ukuqhubeka kokudlala, i-equalizer, itimu, nezintandokazi zolimi.</string>
    <string name="data_storage_library_title">Amafayela omculo</string>
    <string name="data_storage_library_body">Amafayela omsindo awakopishwa nhlobo kudathabheyisi yohlelo lokusebenza. Faka amafolda elabhulali, bese i-Retro Player ifunda amafayela ngqo kudiski.</string>
    <string name="data_storage_playlists_title">Amafayela we-playlist</string>
    <string name="data_storage_playlists_body">Ama-playlist amafayela alula e-.m3u agcinwe ngaphakathi kwemifolda yelayibrari yakho. Ungawahlela kuhlelo lokusebenza noma kunoma iyiphi umhleli wombhalo.</string>
    <string name="data_storage_platform_title">Ipulatifomu: %1$s</string>
    <string name="data_storage_android_permissions_title">Izimvume ze-Android nokugcinwa</string>
    <string name="data_storage_android_native_body">Retro Player igcina idathabheyisi yayo endaweni yokweseka yangasese yohlelo lokusebenza esitoreji sangaphakathi. Amafayela akho omculo ahlala emafolda owazikhethayo kusebenzisi isikhethi sefolder sesistimu.</string>
    <string name="data_storage_android_playback_title">Ukudlalwa kwengoma ngemuva kwe-Android</string>
    <string name="data_storage_android_playback_body">Uma umsindo udlalwa, i-Retro Player isebenzisa insizakalo yemidiya esebenza phambili ukuze ukudlalwa kuqhubeke noma uvale ifoni noma ushintshe izinhlelo zokusebenza, kube nezilawuli zokuhambisa kumsakazo esazisweni sesistimu. Ukuskrola uhlelo lokusebenza kude nohlu lwezinto zakamuva kumisa ukudlalwa futhi kususwa isaziso.</string>
    <string name="data_storage_platform_body_android">Idatha yesicelo igcinwa endaweni yangasese yokweseka yesicelo esitoreji sangaphakathi.</string>
