    <string name="data_storage">Nchekwa data</string>
    <string name="data_storage_intro">Retro Player na-echekwa ntọala ngwa n\'ime obere nchekwa data mpaghara. Egwu gị na ndepụta egwu gị na-anọgide dị ka faịlụ nkịtị n\'ime folda ị họọrọ.</string>
    <string name="data_storage_app_data_title">Nchekwa data ngwa</string>
    <string name="data_storage_app_data_body">Faịlụ: %1$s\nỤzọ: %2$s\n\nNchekwa ndekọ ụlọ ahịa, ọnọdụ nchọgharị, ịga n\'ihu igwu azụmaahịa, nhazi ụda, isiokwu, na nhọrọ asụsụ.</string>
    <string name="data_storage_library_title">Faịlụ egwu</string>
    <string name="data_storage_library_body">A naghị ebu faịlụ ụda n\'ime nchekwa data ngwa. Tinye folda ọbá akwụkwọ, Retro Player na-agụ faịlụ ozugbo site na diski.</string>
    <string name="data_storage_playlists_title">Faịlụ ndepụta egwu</string>
    <string name="data_storage_playlists_body">Playlists bụ faịlụ .m3u dị mfe echekwara n\'ime folda ọbá akwụkwọ gị. Ị nwere ike dezie ha na ngwa ma ọ bụ site na ndetu ederede ọ bụla.</string>
    <string name="data_storage_platform_title">Ikpo okwu: %1$s</string>
    <string name="data_storage_android_permissions_title">Ikike na nchekwa Android</string>
    <string name="data_storage_android_native_body">Retro Player na-echekwa nchekwa data ya na mpaghara nkwado nkeonwe nke ngwa na nchekwa ime. Faịlụ egwu gị na-anọgide n\'ime akpa faịlụ ị họọrọ site na onye nhọpụta akpa faịlụ sistemụ.</string>
    <string name="data_storage_android_playback_title">Ịgba egwu n\'azụ na Android</string>
    <string name="data_storage_android_playback_body">Mgbe ụda na-egwu, Retro Player na-agba ọrụ mgbasa ozi n\'ihu ka ịgba egwu wee gaa n\'ihu ọbụlagodi ma ị mechie ekwentị ma ọ bụ gbanwee ngwa, yana njikwa njem dị na nkwupụta usoro. Ịdọpụ ngwa ahụ pụọ na Ndepụta Ngwa Ngosipụtara na-akwụsị ịgba egwu ma na-ewepụ nkwupụta ahụ.</string>
    <string name="data_storage_platform_body_android">A na-echekwa data ngwa na mpaghara nkwado nkeonwe ngwa na nchekwa ime.</string>
