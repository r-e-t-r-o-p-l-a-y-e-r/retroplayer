    <string name="data_storage">Donanw marali</string>
    <string name="data_storage_intro">Retro Player bɛ porogaramuw sigicogo mara sigida kunnafonidilan fitinin dɔ kɔnɔ. I ka dɔnkiliw ni i ka fɔlisenw bɛ to i n’a fɔ dosiye nɔrɔlenw i ye foli minnu sugandi.</string>
    <string name="data_storage_app_data_title">App database ka kunnafonidilan</string>
    <string name="data_storage_app_data_body">Filen: %1$s Bamako, Mali.\nSira: %2$s\n\nA bɛ gafemarayɔrɔ juw, navigatiɔn cogoya, fɔli daminɛ, equalizer, barokun ani kan fɛɛrɛw mara.</string>
    <string name="data_storage_library_title">Misikili dosiyew</string>
    <string name="data_storage_library_body">Odio filew tɛ kopi kɛ abada appli database kɔnɔ. Bibliothèque foli fara a kan ani Retro Player bɛ filew kalan ka bɔ disiki la.</string>
    <string name="data_storage_playlists_title">Filew minnu bɛ fɔli kɛ</string>
    <string name="data_storage_playlists_body">Fɔlifɛnw ye .m3u file gansanw ye minnu maralen bɛ i ka gafemarayɔrɔ foli kɔnɔ. I bɛ se k’u ladilan appli kɔnɔ walima ni sɛbɛnnikɛlan suguya bɛɛ ye.</string>
    <string name="data_storage_platform_title">Plateforme: %1$s Bamako, Mali.</string>
    <string name="data_storage_android_permissions_title">Android ka yamaruyaw ni a maracogo</string>
    <string name="data_storage_android_native_body">Retro Player b’a ka kunnafonidilan mara app-private dɛmɛyɔrɔ la kɔnɔna marali kan. I ka dɔnkilida-dosiyɛriw bɛ to foli kɔnɔ i bɛ minnu ta ni sistɛmu foli tabaga ye.</string>
    <string name="data_storage_android_playback_title">Android kɔkanna-fɔli</string>
    <string name="data_storage_android_playback_body">Ni odio bɛ fɔ, Retro Player bɛ ɲɛfɛla kunnafonidilan dɔ baara o la fɔli bɛ taa ɲɛ n’i ye telefɔni datugu walima n’i ye porogaramuw caman wuli, ni transport controls ye sistɛmu kunnafoni kɔnɔ. Ni i ye porogaramu in digi ka bɔ Recents la, o bɛ fɔli jɔ ani ka kunnafoni bɔ.</string>
    <string name="data_storage_platform_body_android">Application data bɛ mara app-private dɛmɛyɔrɔ la kɔnɔna marali kan.</string>
