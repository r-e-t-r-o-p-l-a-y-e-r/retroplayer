    <string name="data_storage_intro">Retro Player dzraa dɔwɔnua ƒe ɖoɖowo ɖo ɖe nyatakakadzraɖoƒe sue aɖe si le nutoa me. Wò hadzidziwo kple haƒoƒo ƒe xexlẽdzesiwo nɔa abe faɛl siwo sɔ ene le agbalẽdzraɖoƒe siwo nètia me.</string>
    <string name="data_storage_app_data_title">App ƒe nyatakakadzraɖoƒe</string>
    <string name="data_storage_app_data_body">Faɛl: %1$s\nMɔ: %2$s\n\nDzra agbalẽdzraɖoƒe ƒe kewo, ʋuʋu ƒe nɔnɔme, ƒoƒo ƒe gbugbɔgadzedze, equalizer, tanya, kple gbegbɔgblɔ ƒe tiatia ɖo.</string>
    <string name="data_storage_library_title">Hadzidzi ƒe faɛlwo</string>
    <string name="data_storage_library_body">Womewɔa odio ƒe faɛlwo ƒe kɔpi ɖe app ƒe nyatakakadzraɖoƒea gbeɖe o. Tsɔ agbalẽdzraɖoƒe ƒe agbalẽdzraɖoƒewo kpee eye Retro Player xlẽa faɛlwo tẽ tso disk dzi.</string>
    <string name="data_storage_playlists_title">Haƒoƒo ƒe xexlẽdzesiwo ƒe faɛlwo</string>
    <string name="data_storage_playlists_body">Haƒoƒo ƒe xexlẽdzesiwo nye .m3u faɛl dzro siwo wodzra ɖo ɖe wò agbalẽdzraɖoƒe ƒe agbalẽdzraɖoƒewo me. Àte ŋu atrɔ asi le wo ŋu le dɔwɔnua me alo kple nuŋɔŋlɔ ɖɔlila ɖesiaɖe.</string>
    <string name="data_storage_platform_title">Nuƒolanɔƒe: %1$s</string>
    <string name="data_storage_android_permissions_title">Android ƒe mɔɖeɖewo kple nudzraɖoƒe</string>
    <string name="data_storage_android_native_body">Retro Player dzraa eƒe nyatakakadzraɖoƒe ɖo ɖe app-private support area le ememe nudzraɖoƒe dzi. Wò hadzidzi ƒe faɛlwo nɔa agbalẽdzraɖoƒe siwo nètia kple system folder picker la me.</string>
    <string name="data_storage_android_playback_title">Android ƒe megbenyawo ƒoƒo</string>
    <string name="data_storage_android_playback_body">Ne odio le ɖiɖim la, Retro Player wɔa ŋgɔgbe nyadzɔdzɔdɔwɔƒe aɖe eyata eƒoƒo yia edzi ne ètu telefon la alo trɔ dɔwɔɖoɖowo, kple ʋuɖoɖo ƒe ɖoɖowo le ɖoɖoa ƒe nyatakaka me. Ne ètsɔ asi ƒo dɔwɔnua ɖa le Recents ŋu la, etɔa te eƒoƒo eye wòɖea gbeƒãɖeɖea ɖa.</string>
    <string name="data_storage_platform_body_android">Wodzraa app ƒe nyatakakawo ɖo ɖe app-private support area le ememe nudzraɖoƒe dzi.</string>
