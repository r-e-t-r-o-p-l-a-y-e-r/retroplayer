    <string name="data_storage">Datalagring</string>
    <string name="data_storage_intro">Retro Player gemmer app-indstillingerne i en lille lokal database. Din musik og dine afspilningslister forbliver som almindelige filer i de mapper, du vælger.</string>
    <string name="data_storage_app_data_title">App-database</string>
    <string name="data_storage_app_data_body">Fil: %1$s\nSti: %2$s\n\nGemmer indstillinger for biblioteksrodmapper, gennemsynstilstand, genoptagelse af afspilning, equalizer, tema og sprog.</string>
    <string name="data_storage_library_title">Musikfiler</string>
    <string name="data_storage_library_body">Lydfiler kopieres aldrig til appens database. Tilføj biblioteksmapper, så læser Retro Player filerne direkte fra harddisken.</string>
    <string name="data_storage_playlists_title">Afspilningslistefiler</string>
    <string name="data_storage_playlists_body">Afspilningslister er almindelige .m3u-filer, der er gemt i dine biblioteksmapper. Du kan redigere dem i appen eller med et hvilket som helst tekstredigeringsprogram.</string>
    <string name="data_storage_platform_title">Platform: %1$s</string>
    <string name="data_storage_android_permissions_title">Android-tilladelser og lagerplads</string>
    <string name="data_storage_android_native_body">Retro Player gemmer sin database i appens private supportområde på det interne lager. Dine musikfiler forbliver i de mapper, du vælger via systemets mappevælger.</string>
    <string name="data_storage_android_playback_title">Afspilning i baggrunden på Android</string>
    <string name="data_storage_android_playback_body">Når der afspilles lyd, kører Retro Player en medietjeneste i forgrunden, så afspilningen fortsætter, selvom du låser telefonen eller skifter mellem apps, og afspilningsknapperne vises i systemmeddelelsen. Hvis du stryger appen væk fra listen over seneste apps, stopper afspilningen, og meddelelsen fjernes.</string>
    <string name="data_storage_platform_body_android">Appdata gemmes i det app-specifikke supportområde på det interne lager.</string>
