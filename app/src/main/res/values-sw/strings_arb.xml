    <string name="data_storage">Uhifadhi wa data</string>
    <string name="data_storage_intro">Retro Player huhifadhi mipangilio ya programu katika hifadhidata ndogo ya ndani. Muziki wako na orodha za kucheza hubaki kama faili za kawaida katika folda unazochagua.</string>
    <string name="data_storage_app_data_title">Hifadhidata ya programu</string>
    <string name="data_storage_app_data_body">Faili: %1$s\nNjia: %2$s\n\nHifadhi mizizi ya maktaba, hali ya kuvinjari, kuendelea kucheza, kisawazishaji sauti, mandhari, na mapendeleo ya lugha.</string>
    <string name="data_storage_library_title">Faili za muziki</string>
    <string name="data_storage_library_body">Faili za sauti haziwahi kunakiliwa kwenye hifadhidata ya programu. Ongeza folda za maktaba na Retro Player husoma faili moja kwa moja kutoka kwenye diski.</string>
    <string name="data_storage_playlists_title">Faili za orodha ya nyimbo</string>
    <string name="data_storage_playlists_body">Orodha za nyimbo ni faili rahisi za .m3u zilizohifadhiwa ndani ya folda za maktaba yako. Unaweza kuzihariri katika programu au kwa kihariri chochote cha maandishi.</string>
    <string name="data_storage_platform_title">Jukwaa: %1$s</string>
    <string name="data_storage_android_permissions_title">Ruhusa na hifadhi ya Android</string>
    <string name="data_storage_android_native_body">Retro Player huhifadhi hifadhidata yake katika eneo la msaada la faragha la programu kwenye hifadhi ya ndani. Faili zako za muziki hubaki katika folda unazochagua kwa kutumia chaguo la folda la mfumo.</string>
    <string name="data_storage_android_playback_title">Uchezaji wa nyuma wa Android</string>
    <string name="data_storage_android_playback_body">Wakati sauti inacheza, Retro Player huendesha huduma ya media ya mbele ili uchezaji uendelee hata ukifunga simu au kubadilisha programu, na vidhibiti vya uchezaji viko kwenye arifa ya mfumo. Kupiga swipu programu kutoka kwenye Orodha ya Programu Zilizotumika Hivi Karibuni husitisha uchezaji na kuondoa arifa.</string>
    <string name="data_storage_platform_body_android">Data za programu huhifadhiwa katika eneo la msaada la faragha la programu kwenye hifadhi ya ndani.</string>
