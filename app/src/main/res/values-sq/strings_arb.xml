    <string name="data_storage">Ruajtja e të dhënave</string>
    <string name="data_storage_intro">Retro Player ruan cilësimet e aplikacionit në një bazë të vogël të dhënash lokale. Muzika juaj dhe listat e luajtjes mbeten si skedarë normalë në dosjet që zgjidhni.</string>
    <string name="data_storage_app_data_title">Baza e të dhënave e aplikacionit</string>
    <string name="data_storage_app_data_body">Skedar: %1$s\nRruga: %2$s\n\nRuan rrënjët e bibliotekës, gjendjen e shfletimit, rifillimin e luajtjes, ekualizatorin, temën dhe preferencat e gjuhës.</string>
    <string name="data_storage_library_title">Skedarë muzike</string>
    <string name="data_storage_library_body">Skedarët audio kurrë nuk kopjohen në bazën e të dhënave të aplikacionit. Shtoni dosjet e bibliotekës dhe Retro Player i lexon skedarët direkt nga disku.</string>
    <string name="data_storage_playlists_title">Skedarët e listës së luajtjes</string>
    <string name="data_storage_playlists_body">Playlistat janë skedarë të thjeshtë .m3u të ruajtur brenda dosjeve të bibliotekës suaj. Ju mund t\'i redaktoni ato në aplikacion ose me ndonjë redaktor teksti.</string>
    <string name="data_storage_platform_title">Platformë: %1$s</string>
    <string name="data_storage_android_permissions_title">Lejet dhe ruajtja e Android-it</string>
    <string name="data_storage_android_native_body">Retro Player ruan bazën e të dhënave në zonën private të mbështetjes së aplikacionit në ruajtjen e brendshme. Skedarët tuaj të muzikës mbeten në dosjet që zgjidhni me zgjedhësin e dosjeve të sistemit.</string>
    <string name="data_storage_android_playback_title">Lojtimi në sfond i Android-it</string>
    <string name="data_storage_android_playback_body">Kur audio po luhet, Retro Player përdor një shërbim media në plan të parë që riprodhimi të vazhdojë edhe nëse bllokoni telefonin ose ndryshoni aplikacionet, me kontrolle transporti në njoftimin e sistemit. Tërheqja e aplikacionit nga seksioni \"Të fundit\" ndalon riprodhimin dhe heq njoftimin.</string>
    <string name="data_storage_platform_body_android">Të dhënat e aplikacionit ruhen në zonën private të mbështetjes së aplikacionit në magazinimin e brendshëm.</string>
