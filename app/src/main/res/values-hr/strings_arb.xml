    <string name="data_storage">Pohrana podataka</string>
    <string name="data_storage_intro">Retro Player pohranjuje postavke aplikacije u maloj lokalnoj bazi podataka. Vaša glazba i playliste ostaju kao obične datoteke u mapama koje odaberete.</string>
    <string name="data_storage_app_data_title">Baza aplikacija</string>
    <string name="data_storage_app_data_body">Datoteka: %1$s\nStaza: %2$s\n\nPohranjuje postavke biblioteke, stanje pregledavanja, nastavak reprodukcije, ekvilajzer, temu i jezične postavke.</string>
    <string name="data_storage_library_title">Muzičke datoteke</string>
    <string name="data_storage_library_body">Audio datoteke se nikada ne kopiraju u bazu podataka aplikacije. Dodajte mape knjižnice i Retro Player reproducira datoteke izravno s diska.</string>
    <string name="data_storage_playlists_title">Datoteke s popisom pjesama</string>
    <string name="data_storage_playlists_body">Playliste su obične .m3u datoteke pohranjene u mapama vaše biblioteke. Možete ih uređivati u aplikaciji ili bilo kojem uređivaču teksta.</string>
    <string name="data_storage_platform_title">Platforma: %1$s</string>
    <string name="data_storage_android_permissions_title">Android dozvole i pohrana</string>
    <string name="data_storage_android_native_body">Retro Player pohranjuje svoju bazu podataka u privatnom podržanom prostoru aplikacije na internom skladištu. Vaši glazbeni datoteci ostaju u mapama koje odaberete pomoću sustavnog odabira mapa.</string>
    <string name="data_storage_android_playback_title">Reprodukcija u pozadini na Androidu</string>
    <string name="data_storage_android_playback_body">Kad se audio reproducira, Retro Player pokreće medijsku uslugu u prvom planu kako bi reprodukcija nastavila i ako zaključate telefon ili prijeđete na drugu aplikaciju, s kontrolama reprodukcije u sistemskoj obavijesti. Pomicanjem aplikacije iz popisa nedavnih reprodukcija se zaustavlja i obavijest se uklanja.</string>
    <string name="data_storage_platform_body_android">Podaci aplikacije pohranjuju se u privatnom podržnom prostoru aplikacije na internom skladištu.</string>
