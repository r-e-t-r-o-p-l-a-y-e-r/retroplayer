    <string name="data_storage">Shranjevanje podatkov</string>
    <string name="data_storage_intro">Retro Player shranjuje nastavitve aplikacije v majhni lokalni bazi podatkov. Vaša glasba in seznami predvajanja ostanejo kot običajne datoteke v mapah, ki jih izberete.</string>
    <string name="data_storage_app_data_title">Baza podatkov aplikacij</string>
    <string name="data_storage_app_data_body">Datoteka: %1$s\nPot: %2$s\n\nShranjuje nastavitve za korenske mape knjižnic, stanje brskanja, nadaljevanje predvajanja, ekvalizer, temo in jezik.</string>
    <string name="data_storage_library_title">Glasbene datoteke</string>
    <string name="data_storage_library_body">Zvočne datoteke se nikoli ne kopirajo v bazo podatkov aplikacije. Dodajte mape s knjižnico in Retro Player bo datoteke bral neposredno z diska.</string>
    <string name="data_storage_playlists_title">Datoteke s seznami predvajanja</string>
    <string name="data_storage_playlists_body">Seznami predvajanja so navadne datoteke .m3u, shranjene v mapah vaše knjižnice. Urejate jih lahko v aplikaciji ali s katerim koli urejevalnikom besedil.</string>
    <string name="data_storage_platform_title">Platforma: %1$s</string>
    <string name="data_storage_android_permissions_title">Dovoljenja in shranjevanje v sistemu Android</string>
    <string name="data_storage_android_native_body">Aplikacija Retro Player svojo bazo podatkov shranjuje v zasebnem podpornem območju aplikacije na notranjem pomnilniku. Vaše glasbene datoteke ostanejo v mapah, ki jih izberete s sistemskim izbirnikom map.</string>
    <string name="data_storage_android_playback_title">Predvajanje v ozadju v sistemu Android</string>
    <string name="data_storage_android_playback_body">Med predvajanjem zvoka Retro Player izvaja medijsko storitev v ospredju, tako da se predvajanje nadaljuje, tudi če zaklenete telefon ali preklopite med aplikacijami, pri čemer so gumbi za upravljanje predvajanja na voljo v sistemskem obvestilu. Če aplikacijo s potegom prsta odstranite iz seznama nedavno uporabljenih aplikacij, se predvajanje ustavi in obvestilo izgine.</string>
    <string name="data_storage_platform_body_android">Podatki aplikacije so shranjeni v zasebnem podpornem območju aplikacije na notranjem pomnilniku.</string>
