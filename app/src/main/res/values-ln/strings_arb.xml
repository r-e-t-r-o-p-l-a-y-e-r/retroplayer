    <string name="data_storage">Bobombi ya ba données</string>
    <string name="data_storage_intro">Retro Player ebombaka ba paramètres ya application na kati ya base de données moke ya local. Miziki na yo mpe ba playlists na yo etikalaka lokola ba fichiers normaux na kati ya ba dossiers oyo oponi.</string>
    <string name="data_storage_app_data_title">Base de données ya application</string>
    <string name="data_storage_app_data_body">Fisyé: %1$s\nNzela: %2$s\n\nLibula ya ba magasins, lolenge ya kotala, kokoba lisusu kobeta, égaliseur, thème, mpe maponi ya lokota.</string>
    <string name="data_storage_library_title">Ba fisyé ya miziki</string>
    <string name="data_storage_library_body">Ba fichiers ya mongongo bakopaka yango ata moke te na base de données ya application. Bakisa ba dossiers ya bibliothèque mpe Retro Player etángaka ba fichiers mbala moko uta na disque.</string>
    <string name="data_storage_playlists_title">Ba fisyé ya liste ya miziki</string>
    <string name="data_storage_playlists_body">Ba playlists ezali kaka ba fichiers .m3u oyo ebombami na kati ya ba dossiers ya bibliothèque na yo. Okoki kobongola yango na application to na éditeur ya texte nyonso.</string>
    <string name="data_storage_platform_title">Plateforme: %1$s</string>
    <string name="data_storage_android_permissions_title">Ndingisa mpe ebombelo ya Android</string>
    <string name="data_storage_android_native_body">Retro Player ebombaka base de données na yango na esika ya lisungi oyo ezali sé ya application na mémoire interne. Ba fichiers ya miziki na yo etikalaka na ba dossiers oyo oponi na esaleli ya kopona ba dossiers ya système.</string>
    <string name="data_storage_android_playback_title">Botamboli na sima ya Android</string>
    <string name="data_storage_android_playback_body">Tango mongongo ezali kobeta, Retro Player efungolaka service ya media na liboso, na boye ete kobeta ekoba ata soki okangi telefone to obongoli application, mpe ba boutons ya contrôle ezalaka na notification ya système. Soki olongoli application na liste ya ba applications oyo esalelamaki kala, kobeta ekati mpe notification elongwe.</string>
    <string name="data_storage_platform_body_android">Ba données ya application ebombamaka na esika ya lisungi ya application moko na kati ya mémoire interne.</string>
