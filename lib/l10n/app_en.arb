  "dataStorage": "Data storage",
  "dataStorageIntro": "Retro Player keeps app settings in a small local database. Your music and playlists stay as normal files in folders you choose.",
  "dataStorageAppDataTitle": "App database",
  "dataStorageAppDataBody": "File: {dbFileName}\nPath: {dbPath}\n\nStores library roots, browse state, playback resume, equalizer, theme, and language preferences.",
  "@dataStorageAppDataBody": {
    "placeholders": {
