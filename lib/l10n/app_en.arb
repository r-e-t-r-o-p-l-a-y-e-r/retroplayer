    }
  },
  "dataStorageLibraryTitle": "Music files",
  "dataStorageLibraryBody": "Audio files are never copied into the app database. Add library folders and Retro Player reads files directly from disk.",
  "dataStoragePlaylistsTitle": "Playlist files",
  "dataStoragePlaylistsBody": "Playlists are plain .m3u files stored inside your library folders. You can edit them in the app or with any text editor.",
  "dataStoragePlatformTitle": "Platform: {platform}",
  "@dataStoragePlatformTitle": {
    "placeholders": {
      "platform": {"type": "String"}
    }
  },
  "dataStoragePlatformBodyLinux": "App data is stored under your app-support directory (typically ~/.local/share/app.retroplayer/).",
  "dataStorageLinuxDataTitle": "Linux app data",
  "dataStorageLinuxDataBody": "App data stays in ~/.local/share/app.retroplayer/. That folder is only for the database and settings.",
  "dataStorageLinuxTaskbarTitle": "Linux taskbar integration",
  "dataStorageLinuxTaskbarBody": "For the taskbar and app grid icon, Linux desktop environments expect separate Freedesktop files. Retro Player installs these from the app bundle on startup:\n\n• ~/.local/share/applications/app.retroplayer.desktop — launcher entry that links the running window to this app\n• ~/.local/share/icons/hicolor/*/apps/app.retroplayer.png — themed icons copied from the bundle\n\nIt never writes a user hicolor/index.theme (that would shadow the system theme and hide other icons). Icons are also embedded in the app binary. The copies above help GNOME/KDE show the correct launcher icon instead of a generic placeholder.",
  "dataStorageAndroidPermissionsTitle": "Android permissions and storage",
  "dataStorageAndroidPermissionsBody": "Retro Player stores its database in the app-private support area on internal storage. Your music files stay in folders you pick with the system folder picker.\n\nOn Android, the app may request audio access to read tracks, and photos/images access so folder artwork (for example cover.jpg) can be shown. Audio files are never copied into the app database.",
  "dataStorageAndroidPlaybackTitle": "Android background playback",
  "dataStorageAndroidPlaybackBody": "When audio is playing, Retro Player runs a foreground media service so playback continues if you lock the phone or switch apps, with transport controls in the system notification. Swiping the app away from Recents stops playback and removes the notification.",
  "dataStorageIOSAccessTitle": "iOS folder access",
  "dataStorageIOSAccessBody": "Retro Player stores its database in the app-private support area on device storage. Your music files stay in folders you choose with the system folder picker.\n\niOS grants access through security-scoped URLs for folders you select. Retro Player reads files directly from those locations; it does not copy your library into app storage.",
  "dataStorageIOSPlaybackTitle": "iOS background audio",
  "dataStorageIOSPlaybackBody": "Playback can continue while the app is in the background or the screen is locked. Resume positions and queue state are stored in the local app database.",
  "dataStoragePlatformBodyAndroid": "App data is stored in the app-private support area on internal storage.",
  "dataStoragePlatformBodyIOS": "App data is stored in the app-private support area on device storage.",
  "dataStoragePlatformBodyMacOS": "App data is stored under ~/Library/Application Support/app.retroplayer/.",
  "dataStoragePlatformBodyWindows": "App data is stored under your application support directory.",
  "dataStoragePlatformBodyWeb": "App data is stored in browser-local storage for this origin.",
  "dataStoragePlatformBodyUnknown": "App data is stored in the platform application support area.",
