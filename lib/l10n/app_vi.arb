  },
  "dataStoragePlatformTitle": "Nền tảng: {platform}",
  "dataStoragePlatformBodyLinux": "Dữ liệu ứng dụng được lưu trữ trong thư mục hỗ trợ ứng dụng của bạn (thường là ~/.local/share/app.retroplayer/).",
  "dataStorageLinuxDataTitle": "Dữ liệu ứng dụng Linux",
  "dataStorageLinuxDataBody": "Dữ liệu ứng dụng nằm trong thư mục ~/.local/share/app.retroplayer/. Thư mục này chỉ dành cho cơ sở dữ liệu và cài đặt.",
  "dataStorageLinuxTaskbarTitle": "Tích hợp thanh tác vụ Linux",
  "dataStorageLinuxTaskbarBody": "Đối với biểu tượng trên thanh tác vụ và lưới ứng dụng, môi trường máy tính để bàn Linux yêu cầu các tệp Freedesktop riêng biệt. Retro Player cài đặt các tệp này từ gói ứng dụng khi khởi động:\n\n• ~/.local/share/applications/app.retroplayer.desktop — mục khởi chạy liên kết cửa sổ đang chạy với ứng dụng này\n• ~/.local/share/icons/hicolor/*/apps/app.retroplayer.png — các biểu tượng theo chủ đề được sao chép từ gói\n\nNó không bao giờ ghi tệp hicolor/index.theme của người dùng (vì điều đó sẽ che khuất chủ đề hệ thống và ẩn các biểu tượng khác). Các biểu tượng cũng được nhúng trong tệp nhị phân của ứng dụng. Các bản sao ở trên giúp GNOME/KDE hiển thị biểu tượng trình khởi chạy chính xác thay vì biểu tượng giữ chỗ chung chung.",
  "dataStorageAndroidPermissionsTitle": "Quyền và bộ nhớ Android",
  "dataStorageAndroidPermissionsBody": "Retro Player lưu trữ cơ sở dữ liệu của nó trong khu vực hỗ trợ riêng của ứng dụng trên bộ nhớ trong. Các tệp nhạc của bạn nằm trong các thư mục bạn chọn bằng bộ chọn thư mục hệ thống.\n\nTrên Android, ứng dụng có thể yêu cầu truy cập âm thanh để đọc các bản nhạc và truy cập ảnh/hình ảnh để có thể hiển thị tác phẩm nghệ thuật của thư mục (ví dụ: cover.jpg). Các tệp âm thanh không bao giờ được sao chép vào cơ sở dữ liệu ứng dụng.",
  "dataStorageAndroidPlaybackTitle": "Phát lại trong nền Android",
  "dataStorageAndroidPlaybackBody": "Khi phát âm thanh, Retro Player chạy dịch vụ phương tiện nền trước để tiếp tục phát nếu bạn khóa điện thoại hoặc chuyển đổi ứng dụng, với các điều khiển vận chuyển trong thông báo hệ thống. Vuốt ứng dụng ra khỏi Recents, dừng phát lại và xóa thông báo.",
  "dataStorageIOSAccessTitle": "Truy cập thư mục",
  "dataStorageIOSAccessBody": "Retro Player lưu trữ cơ sở dữ liệu của nó trong khu vực hỗ trợ riêng tư của ứng dụng trên bộ nhớ thiết bị. Các tệp nhạc của bạn vẫn nằm trong các thư mục bạn chọn bằng trình chọn thư mục hệ thống.&#10;&#10; iOS cấp quyền truy cập thông qua các URL có phạm vi bảo mật cho các thư mục bạn chọn. Retro Player đọc trực tiếp các tệp từ các vị trí đó; nó không sao chép thư viện của bạn vào bộ nhớ ứng dụng.",
  "dataStorageIOSPlaybackTitle": "âm thanh nền",
  "dataStorageIOSPlaybackBody": "Phát lại có thể tiếp tục trong khi ứng dụng ở chế độ nền hoặc màn hình bị khóa. Vị trí sơ yếu lý lịch và trạng thái hàng đợi được lưu trữ trong cơ sở dữ liệu ứng dụng cục bộ.",
  "dataStoragePlatformBodyAndroid": "Dữ liệu ứng dụng được lưu trữ trong khu vực hỗ trợ riêng của ứng dụng trên bộ nhớ trong.",
  "dataStoragePlatformBodyIOS": "Dữ liệu ứng dụng được lưu trữ trong khu vực hỗ trợ riêng của ứng dụng trên bộ nhớ thiết bị.",
  "dataStoragePlatformBodyMacOS": "Dữ liệu ứng dụng được lưu trữ trong ~/Library/Application Support/app.retroplayer/.",
  "dataStoragePlatformBodyWindows": "Dữ liệu ứng dụng được lưu trữ trong thư mục hỗ trợ ứng dụng của bạn.",
  "dataStoragePlatformBodyWeb": "Dữ liệu ứng dụng được lưu trữ trong bộ nhớ cục bộ của trình duyệt cho nguồn gốc này.",
  "dataStoragePlatformBodyUnknown": "Dữ liệu ứng dụng được lưu trữ trong khu vực hỗ trợ ứng dụng nền tảng.",
